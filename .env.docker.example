# Copy to .env; generate your own values. Never commit .env.
SKYWEAVER_SECRET_KEY=
SKYWEAVER_ADMIN_PASSWORD=
SKYWEAVER_ADMIN_USERNAME=admin
SKYWEAVER_IMAGE=ghcr.io/acocalypso/sky-weaver-hub:latest
# Loopback by default. Set 0.0.0.0 to allow trusted LAN clients.
SKYWEAVER_BIND_ADDRESS=127.0.0.1
SKYWEAVER_PORT=8765
SKYWEAVER_PRIMARY_CAMERA_ADAPTER=mock
SKYWEAVER_OBSERVATORY_NAME=Sky Weaver Observatory
SKYWEAVER_OBSERVATORY_LATITUDE=0
SKYWEAVER_OBSERVATORY_LONGITUDE=0
SKYWEAVER_OBSERVATORY_TIMEZONE=UTC
SKYWEAVER_PUBLIC_PAGE_ENABLED=false
